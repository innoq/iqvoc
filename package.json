{
  "name": "iqvoc",
  "version": "4.14.5",
  "description": "iQvoc - a SKOS(-XL) vocabulary management system built on the Semantic Web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innoq/iqvoc.git"
  },
  "main": "app/javascript/manifest.js",
  "files": [
    "app/assets/**/*",
    "app/javascript/**/*"
  ],
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "sass ./app/assets/stylesheets/manifest.scss:./app/assets/builds/manifest.css --no-source-map --load-path=node_modules"
  },
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/innoq/iqvoc/issues"
  },
  "homepage": "https://github.com/innoq/iqvoc#readme",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "sass": "^1.80.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@rails/ujs": "^7.1.600",
    "bootstrap": "^5.3.3",
    "bootstrap-datepicker": "^1.10.1",
    "document-register-element": "^1.14.5",
    "jqtree": "^1.4.12",
    "jquery": "^3.6.0",
    "simplete": "^1.7.0",
    "typeahead.js": "^0.10.5"
  }
}
