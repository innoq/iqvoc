<div class="row g-0 align-items-center bg-white search-input mb-3">
  <div class="col-auto">
    <i class="fa-solid fa-magnifying-glass fa-lg"></i>
  </div>
  <div class="col">
    <%= search_field_tag :q, params[:query],
                         class: 'form-control form-control-lg form-control-borderless border-0',
                         placeholder: t('txt.views.search_results.search_term'),
                         autofocus: true,
                         autocomplete: 'off' %>
  </div>
  <div class="col-auto">
    <%= submit_tag t('txt.views.search_results.submit'), class: 'btn w-100 btn-lg btn-primary p-2' %>
  </div>
</div>
